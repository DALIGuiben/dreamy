# SQLite by default. For MySQL: mysql+pymysql://USER:PASSWORD@HOST:3306/dreamy
DATABASE_URL="sqlite:///./dreamy.db"
# Random string of at least 32 characters, used to sign access tokens.
AUTH_SECRET="REPLACE_WITH_SECURE_SECRET"
GROQ_API_KEY="REPLACE_WITH_API_KEY"
GROQ_LLM_MODEL="openai/gpt-oss-20b"
GROQ_STT_MODEL="whisper-large-v3-turbo"
AI_ENABLED="true"
# Optional: password given to the demo accounts by `python -m app.seed`.
DEMO_PASSWORD="sosve2026"
